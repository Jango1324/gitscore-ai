# Secrets / local config
.env

# Python
__pycache__/
*.pyc
*.pyo
.venv/

# Packaging / build artifacts (regenerated by pip/setuptools; never commit)
build/
dist/
*.egg-info/

# Test tooling
.pytest_cache/
.coverage
htmlcov/

# Local SQLite dev database (+ journal/WAL/SHM sidecar files)
data/gitscore.db
data/*.db
data/*.db-journal
data/*.db-wal
data/*.db-shm
data/*.sqlite
data/*.sqlite*-journal
data/*.sqlite*-wal
data/*.sqlite*-shm
data/*.sqlite3
data/raw/
data/processed/

# Batch-collection input: the real curated list is local-only; the
# committed template is data/collection/usernames.example.txt
data/collection/usernames.txt

# Future model artifacts (CatBoost etc.) — not produced yet, ignored proactively
models/
*.cbm
*.pkl
*.joblib

# Notebooks
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
